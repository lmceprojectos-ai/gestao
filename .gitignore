prisma/*.db

# local file uploads (dev-only storage, replaces S3 when LOCAL_STORAGE=true)
/.local-uploads/

# large / personal reference material — keep locally, don't push
docs/uploads-originais/

# zips de deploy manual (cPanel) e artefactos de build — gerados localmente, não fazem parte do código
*.zip
/abacus/
.env.production
