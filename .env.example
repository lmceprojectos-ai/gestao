# Modelo do .env para o cPanel (copiar para .env e preencher)

# Base de dados MySQL/MariaDB criada no cPanel
DATABASE_URL="mysql://UTILIZADOR:PALAVRAPASSE@localhost:3306/NOME_DA_BD"

# Endereço público da app (sem barra final) e segredo de sessão (manter o atual para não
# invalidar links já enviados; ou gerar um novo com: openssl rand -base64 32)
NEXTAUTH_URL="https://gestao.kh4.pt"
NEXTAUTH_SECRET=""

# Pasta onde ficam os documentos carregados — FORA da pasta da app
LOCAL_UPLOADS_DIR="/home/CONTA/gestao-uploads"

# Email (SMTP da conta de email criada no cPanel)
SMTP_HOST="mail.kh4.pt"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""


# Tarefas agendadas (cron do cPanel envia este valor no cabeçalho x-cron-key)
CRON_SECRET=""

# Moloni
MOLONI_CLIENT_ID=""
MOLONI_CLIENT_SECRET=""
MOLONI_USERNAME=""
MOLONI_PASSWORD=""
MOLONI_COMPANY_ID=""
MOLONI_PRODUCT_ID=""

# IfThenPay
IFTHENPAY_MBKEY=""
IFTHENPAY_MBWAYKEY=""
IFTHENPAY_BACKOFFICE_KEY=""
IFTHENPAY_ANTIPHISHING_KEY=""

# OneDrive (Microsoft Graph) — importação de digitalizações
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_DRIVE_USER=""
MS_GRAPH_ROOT_PATH=""
